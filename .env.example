# .env.example - Copier vers .env.local et remplir les valeurs

# Application
NODE_ENV=development
VITE_APP_NAME=DevOps Hub Pro

# Gemini API
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Docker & Services
COMPOSE_PROJECT_NAME=devops-hub-pro
NGINX_PORT=80
APP_PORT=3000

# Logging
LOG_LEVEL=info

# Security
# JWT_SECRET=your_jwt_secret_here
# API_RATE_LIMIT=100
